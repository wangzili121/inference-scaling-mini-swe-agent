      "vllm.engine_kwargs.max_long_partial_prefills=1",
      "vllm.request_priority_policy=\"step_fifo\"",
      "vllm.scheduler_cls=\"inference_scaling.arllm.backends.cis_scheduler.CISTreeScheduler\""
    ]
  }
}
