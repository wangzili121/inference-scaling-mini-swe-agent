# Copy to .env on the internal host. MODEL_DIR must be a complete local snapshot.
MODEL_DIR=/workspace/models/DeepSeek-V4-Flash-0731-w8a8
IMAGE=quay.io/ascend/vllm-ascend:nightly-releases-v0.26.0rc
DEVICES=0,1,2,3,4,5,6,7
CONFIRM_DEVICES_FREE=no
PORT=8123
HOST=127.0.0.1
CONTAINER_NAME=cis-dsv4-0731
ARTIFACT_DIR=/path/to/cis-dsv4-artifacts
SHM_SIZE=512g
TP=8
DP=1
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
ENABLE_PREFIX_CACHING=true
PREFIX_CACHE_RETENTION_INTERVAL=4096
ENABLE_JEMALLOC=false
VLLM_WORKER_MULTIPROC_METHOD=spawn
ENFORCE_EAGER=false
CANDIDATE_COUNT=8
ROLLOUT_COUNT=3
BLOCK_SIZE=128
MAX_NEW_TOKENS=512
MAX_COMPLETION_TOKENS=2048
REWARD_KIND=consilience
REWARD_TEMPERATURE=2.0
ALLOW_NONSTANDARD_ALGORITHM=no
SCHEDULER_VARIANT=baseline
ACTIVE_STEP_KV_FRACTION=0.80
ACTIVE_STEP_MAX_LIMIT=32
ONE_CLICK_RESTART_OWN_CONTAINER=yes
MAX_IDLE_HBM_MB=8192
BENCH_NUM_PROMPTS=16
BENCH_OUTPUT_LEN=512
BENCH_CONCURRENCIES="2 4 8 16"
