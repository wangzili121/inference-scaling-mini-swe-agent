+            use_tiled_selected = (
+                os.getenv("VLLM_TILED_SELECTED_TOKEN_LOGPROBS", "0") == "1"
+                and num_prompt_logprobs == 0
+            )
+            if use_tiled_selected:
+                target_ids = tgt_token_ids.unsqueeze(-1)
+                target_logits = logits.gather(-1, target_ids)
+                target_logits_fp32 = target_logits.float()
+                row_max = torch.full_like(target_logits_fp32, -torch.inf)
+                exp_sum = torch.zeros_like(target_logits_fp32)
+                ranks = torch.zeros(
+                    logits.shape[0], dtype=torch.int64, device=logits.device
+                )
+                vocab_tile_size = int(
+                    os.getenv("VLLM_SELECTED_TOKEN_VOCAB_TILE_SIZE", "8192")
+                )
+                if vocab_tile_size <= 0:
+                    raise ValueError(
+                        "VLLM_SELECTED_TOKEN_VOCAB_TILE_SIZE must be positive"
+                    )
+                for vocab_start in range(0, logits.shape[-1], vocab_tile_size):
+                    tile = logits[
+                        :, vocab_start : vocab_start + vocab_tile_size
+                    ].float()
+                    tile_max = tile.amax(dim=-1, keepdim=True)
+                    merged_max = torch.maximum(row_max, tile_max)
+                    exp_sum = (
+                        exp_sum * torch.exp(row_max - merged_max)
+                        + torch.exp(tile - merged_max).sum(dim=-1, keepdim=True)
+                    )
+                    row_max = merged_max
+                    ranks.add_((tile >= target_logits_fp32).sum(dim=-1))
+                logprobs = target_logits_fp32 - (row_max + torch.log(exp_sum))
+                token_ids = target_ids.to(torch.int32)
+            else:
+                logprobs = self.sampler.compute_logprobs(logits)
+                token_ids, logprobs, ranks, _ = self.sampler.gather_logprobs(
+                    logprobs, num_prompt_logprobs, tgt_token_ids
+                )
 
