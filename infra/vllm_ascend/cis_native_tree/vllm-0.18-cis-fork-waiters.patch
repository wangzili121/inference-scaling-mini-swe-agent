+        logger.info(
+            "CIS_ENGINE_FORK activated children=%d parent=%s candidate_tokens=%d",
+            len(children),
+            parent.request_id,
+            len(candidate_tokens),
+        )
+        self._account_cis_fork_children(fork_handle, len(children))
