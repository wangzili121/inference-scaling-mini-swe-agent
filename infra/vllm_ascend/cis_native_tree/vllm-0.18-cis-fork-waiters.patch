+        candidate_tokens = list(parent.output_token_ids)
+        if not candidate_tokens:
+            raise RuntimeError("CIS engine fork parent produced no candidate tokens")
+        for child in children:
+            self._cis_fork_parent_by_child.pop(child.request_id, None)
+            if child.prompt_token_ids is None or child.prompt_embeds is not None:
+                raise RuntimeError("CIS engine fork currently requires token prompts")
+            child.prompt_token_ids.extend(candidate_tokens)
