+    def _release_cis_fork_parent(
+        self, parent: Request, fork_handle: str
+    ) -> None:
+        self._cis_fork_released_parents.add(fork_handle)
+        self._activate_cis_fork_waiters(parent, fork_handle)
+
+    def _account_cis_fork_children(
+        self, fork_handle: str, count: int
+    ) -> None:
+        remaining = self._cis_fork_parent_remaining_children[fork_handle] - count
+        if remaining < 0:
+            raise RuntimeError("CIS fork parent received too many children")
+        if remaining:
+            self._cis_fork_parent_remaining_children[fork_handle] = remaining
+            return
+        self._cis_fork_parent_remaining_children.pop(fork_handle, None)
+        self._cis_fork_completed_parents.pop(fork_handle, None)
+        self._cis_fork_released_parents.discard(fork_handle)
+
+    def _activate_cis_fork_waiters(
+        self, parent: Request, fork_handle: str
+    ) -> None:
+        children = self._cis_fork_waiters.pop(fork_handle, [])
+        if not children:
+            return
+        if parent.status != RequestStatus.FINISHED_LENGTH_CAPPED:
+            for child in children:
+                self._cis_fork_parent_by_child.pop(child.request_id, None)
+                child.status = RequestStatus.FINISHED_ABORTED
+                child.stop_reason = "cis_parent_terminal"
+                self._finish_parked_cis_fork_waiter(child)
