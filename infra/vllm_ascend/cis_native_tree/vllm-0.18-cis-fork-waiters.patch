+    def _finish_parked_cis_fork_waiter(self, request: Request) -> None:
+        self.finished_req_ids.add(request.request_id)
+        if self.finished_req_ids_dict is not None:
+            self.finished_req_ids_dict[request.client_index].add(request.request_id)
+        self.requests.pop(request.request_id, None)
+
+    @staticmethod
+    def _cis_frontend_cached_tokens(request: Request) -> int:
+        params = request.sampling_params
+        extra_args = None if params is None else params.extra_args
+        frontend_prompt_tokens = (extra_args or {}).get(
+            "cis_fork_frontend_prompt_tokens"
+        )
+        if frontend_prompt_tokens is None:
+            return request.num_cached_tokens
+        return min(request.num_cached_tokens, int(frontend_prompt_tokens))
+
+    def _complete_cis_fork_parent(
+        self, parent: Request, fork_handle: str
+    ) -> None:
+        params = parent.sampling_params
+        extra_args = None if params is None else params.extra_args
+        expected_children = int(
+            (extra_args or {}).get("cis_fork_expected_children", 0)
+        )
+        if expected_children <= 0:
+            raise RuntimeError("CIS fork parent is missing its child count")
+        if fork_handle in self._cis_fork_completed_parents:
+            raise RuntimeError("CIS fork parent completed more than once")
+        self._cis_fork_completed_parents[fork_handle] = parent
+        self._cis_fork_parent_remaining_children[fork_handle] = expected_children
+        group_id_value = (extra_args or {}).get("cis_fork_group_id")
+        if group_id_value is None:
+            self._release_cis_fork_parent(parent, fork_handle)
+            return
+        group_id = str(group_id_value)
+        remaining = self._cis_fork_group_remaining[group_id] - 1
+        self._cis_fork_group_remaining[group_id] = remaining
+        if parent.status == RequestStatus.FINISHED_LENGTH_CAPPED:
+            self._cis_fork_group_pending[group_id].append((parent, fork_handle))
+        else:
+            self._release_cis_fork_parent(parent, fork_handle)
+
+        release_remaining = self._cis_fork_group_release_remaining[group_id]
+        if group_id in self._cis_fork_groups_released or remaining <= release_remaining:
+            self._cis_fork_groups_released.add(group_id)
+            pending = self._cis_fork_group_pending.pop(group_id, [])
+            for ready_parent, ready_handle in pending:
+                self._release_cis_fork_parent(ready_parent, ready_handle)
+            if pending:
+                logger.info(
+                    "CIS_ENGINE_FORK group_release group=%s parents=%d "
+                    "remaining=%d threshold=%d",
+                    group_id,
+                    len(pending),
+                    remaining,
+                    release_remaining,
+                )
+        if remaining == 0:
+            if self._cis_fork_group_pending.get(group_id):
+                raise RuntimeError("CIS fork group completed with parked ready parents")
+            self._cis_fork_group_remaining.pop(group_id, None)
+            self._cis_fork_group_size.pop(group_id, None)
+            self._cis_fork_group_release_remaining.pop(group_id, None)
+            self._cis_fork_group_adaptive.pop(group_id, None)
+            self._cis_fork_group_runnable_fraction.pop(group_id, None)
+            self._cis_fork_group_pending.pop(group_id, None)
+            self._cis_fork_groups_released.discard(group_id)
+
+    def _release_cis_fork_waiters_for_capacity(self) -> None:
+        runnable = len(self.running) + len(self.waiting) + len(self.skipped_waiting)
+        for group_id in tuple(self._cis_fork_group_pending):
+            if not self._cis_fork_group_adaptive.get(group_id, False):
+                continue
+            target = max(
+                1,
+                int(
+                    self.max_num_running_reqs
+                    * self._cis_fork_group_runnable_fraction[group_id]
+                ),
+            )
+            available = target - runnable
+            if available <= 0:
+                continue
+            pending = self._cis_fork_group_pending[group_id]
+            released = 0
+            released_children = 0
+            while pending and available > 0:
+                parent, fork_handle = pending.pop(0)
+                children = len(self._cis_fork_waiters.get(fork_handle, ()))
+                self._release_cis_fork_parent(parent, fork_handle)
+                released += 1
+                released_children += children
+                available -= max(1, children)
+                runnable += children
+            if not pending:
+                self._cis_fork_group_pending.pop(group_id, None)
+            if released:
+                logger.info(
+                    "CIS_ENGINE_FORK adaptive_release group=%s parents=%d "
+                    "children=%d runnable=%d target=%d",
+                    group_id,
+                    released,
+                    released_children,
+                    runnable,
+                    target,
+                )
