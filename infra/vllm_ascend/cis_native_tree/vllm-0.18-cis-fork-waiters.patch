+                            events=child.take_events(),
+                            trace_headers=child.trace_headers,
+                            num_cached_tokens=0,
+                        ),
+                    )
+                )
+            logger.info(
+                "CIS_ENGINE_FORK cancelled children=%d parent=%s status=%s",
+                len(children),
+                parent.request_id,
+                parent.status,
+            )
+            self._account_cis_fork_children(fork_handle, len(children))
+            return
