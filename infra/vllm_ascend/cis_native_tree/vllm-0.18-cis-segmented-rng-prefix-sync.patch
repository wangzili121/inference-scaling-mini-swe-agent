+    def _retire_cis_rng_prefix_request(self, req_id: str) -> None:
+        prefix_group = self._cis_rng_prefix_group_by_request.pop(req_id, None)
+        if prefix_group is None:
+            return
+
+        members = self._cis_rng_prefix_group_members[prefix_group]
+        members.discard(req_id)
+        expected = self._cis_rng_prefix_group_expected[prefix_group]
+        if (
+            not members
+            and len(self._cis_rng_prefix_group_seen[prefix_group]) >= expected
+        ):
+            self._cis_rng_prefix_group_members.pop(prefix_group, None)
+            self._cis_rng_prefix_group_seen.pop(prefix_group, None)
+            self._cis_rng_prefix_group_expected.pop(prefix_group, None)
+            self._cis_rng_prefix_cache.pop(prefix_group, None)
+
+    def _switch_cis_segmented_rng(self) -> None:
+        if not self._cis_segmented_rng_pending:
+            return
+
+        switched: list[str] = []
+        for req_id in self._cis_segmented_rng_pending:
+            req_state = self.requests.get(req_id)
+            if req_state is None or req_state.sampling_params is None:
+                switched.append(req_id)
+                continue
+            extra_args = req_state.sampling_params.extra_args or {}
+            boundary = int(extra_args["cis_rng_switch_after_tokens"])
+            if len(req_state.output_token_ids) < boundary:
+                continue
+            if req_state.generator is None:
+                raise RuntimeError("CIS segmented RNG requires a request-local seed")
+            req_state.generator.manual_seed(int(extra_args["cis_rng_switch_seed"]))
+            switched.append(req_id)
+
+        self._cis_segmented_rng_pending.difference_update(switched)
+        for req_id in switched:
+            self._retire_cis_rng_prefix_request(req_id)
+        if switched and not self._cis_segmented_rng_logged:
+            logger.info(
+                "CIS segmented RNG switched %d request generator(s) at the "
+                "candidate boundary",
+                len(switched),
+            )
+            self._cis_segmented_rng_logged = True
+
+    def _synchronize_cis_rng_prefix(
+        self, sampler_output: SamplerOutput
+    ) -> SamplerOutput:
+        if not self._cis_rng_prefix_group_by_request:
+            return sampler_output
+        if sampler_output.sampled_token_ids.shape[1] != 1:
+            raise RuntimeError("CIS RNG prefix synchronization does not support spec decode")
+
+        synchronized = 0
+        num_sampled = sampler_output.sampled_token_ids.shape[0]
+        logprobs = sampler_output.logprobs_tensors
+        for req_index, req_id in enumerate(self.input_batch.req_ids[:num_sampled]):
+            prefix_group = self._cis_rng_prefix_group_by_request.get(req_id)
+            if prefix_group is None or self.discard_request_mask.np[req_index]:
+                continue
+            req_state = self.requests[req_id]
+            extra_args = req_state.sampling_params.extra_args or {}
+            boundary = int(extra_args["cis_rng_switch_after_tokens"])
+            position = len(req_state.output_token_ids)
+            if position >= boundary:
+                continue
+
+            cache = self._cis_rng_prefix_cache.get(prefix_group)
+            if cache is None:
+                sampled = sampler_output.sampled_token_ids
+                cache = {
+                    "seen": set(),
+                    "sampled_token_ids": torch.empty(
+                        (boundary, sampled.shape[1]),
+                        dtype=sampled.dtype,
+                        device=sampled.device,
+                    ),
+                }
+                if logprobs is not None:
+                    cache.update(
+                        {
+                            "logprob_token_ids": torch.empty(
+                                (boundary, logprobs.logprob_token_ids.shape[1]),
+                                dtype=logprobs.logprob_token_ids.dtype,
+                                device=logprobs.logprob_token_ids.device,
+                            ),
+                            "logprobs": torch.empty(
+                                (boundary, logprobs.logprobs.shape[1]),
+                                dtype=logprobs.logprobs.dtype,
+                                device=logprobs.logprobs.device,
+                            ),
+                            "selected_token_ranks": torch.empty(
+                                boundary,
+                                dtype=logprobs.selected_token_ranks.dtype,
+                                device=logprobs.selected_token_ranks.device,
+                            ),
+                        }
+                    )
+                self._cis_rng_prefix_cache[prefix_group] = cache
+
+            seen = cache["seen"]
+            if position not in seen:
+                cache["sampled_token_ids"][position].copy_(
+                    sampler_output.sampled_token_ids[req_index]
+                )
+                if logprobs is not None:
+                    cache["logprob_token_ids"][position].copy_(
+                        logprobs.logprob_token_ids[req_index]
+                    )
+                    cache["logprobs"][position].copy_(logprobs.logprobs[req_index])
+                    cache["selected_token_ranks"][position].copy_(
+                        logprobs.selected_token_ranks[req_index]
+                    )
+                seen.add(position)
+            else:
+                sampler_output.sampled_token_ids[req_index].copy_(
+                    cache["sampled_token_ids"][position]
+                )
+                if logprobs is not None:
+                    logprobs.logprob_token_ids[req_index].copy_(
+                        cache["logprob_token_ids"][position]
+                    )
+                    logprobs.logprobs[req_index].copy_(cache["logprobs"][position])
+                    logprobs.selected_token_ranks[req_index].copy_(
+                        cache["selected_token_ranks"][position]
+                    )
+                synchronized += 1
+
+        if synchronized and not self._cis_rng_prefix_sync_logged:
+            logger.info(
+                "CIS RNG prefix synchronization reused %d sampled token(s)",
+                synchronized,
+            )
+            self._cis_rng_prefix_sync_logged = True
+        return sampler_output
+
