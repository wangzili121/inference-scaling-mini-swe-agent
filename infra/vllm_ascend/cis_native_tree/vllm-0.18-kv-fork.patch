+    def _get_cis_forked_blocks(
+        self, request: Request
+    ) -> tuple[KVCacheBlocks, int] | None:
+        self._expire_cis_fork_hints()
+        params = request.sampling_params
+        extra_args = None if params is None else params.extra_args
+        parent_id = (extra_args or {}).get("cis_fork_parent_request_id")
+        if not parent_id:
+            return None
+        if request.request_id in self._cis_failed_forks:
+            return None
+        hint = self._cis_fork_hints.get(str(parent_id))
+        if hint is None:
+            self._cis_failed_forks.add(request.request_id)
+            logger.info(
+                "CIS_KV_FORK miss child=%s parent=%s reason=no_hint",
+                request.request_id,
+                parent_id,
+            )
+            return None
+        valid = (
+            len(request.block_hashes) >= len(hint.block_hashes)
+            and tuple(request.block_hashes[: len(hint.block_hashes)])
+            == hint.block_hashes
+            and tuple(
+                None if block.block_hash is None else get_block_hash(block.block_hash)
+                for block in hint.blocks
+            )
+            == hint.block_hashes
+        )
+        if not valid:
+            self._release_cis_fork_hint(str(parent_id))
+            self._cis_failed_forks.add(request.request_id)
+            logger.info(
+                "CIS_KV_FORK miss child=%s parent=%s reason=stale_or_mismatch",
+                request.request_id,
+                parent_id,
+            )
+            return None
+        self._cis_pending_forks[request.request_id] = str(parent_id)
+        logger.info(
+            "CIS_KV_FORK hit child=%s parent=%s tokens=%d scope=%s",
+            request.request_id,
+            parent_id,
+            hint.num_tokens,
+            hint.lease_scope,
+        )
+        return KVCacheBlocks((hint.blocks,)), hint.num_tokens
+
+    def _commit_cis_fork(self, request_id: str) -> None:
+        self._cis_failed_forks.discard(request_id)
+        parent_id = self._cis_pending_forks.pop(request_id, None)
+        if parent_id is None:
+            return
+        self._cis_accounted_fork_children.add(request_id)
+        self._consume_cis_fork_child(parent_id)
+
+    def _consume_cis_fork_child(self, parent_id: str) -> None:
+        hint = self._cis_fork_hints.get(parent_id)
+        if hint is None:
+            return
+        hint.remaining_children -= 1
+        if hint.remaining_children <= 0:
+            self._release_cis_fork_hint(parent_id)
+
+    def _capture_cis_branch_record(
+        self,
+        request: Request,
+        disposable_from_token: int,
+        branch_kind: str,
+    ) -> None:
+        if not self.enable_caching or self.num_kv_cache_groups != 1:
+            return
+        blocks = tuple(self.coordinator.get_blocks(request.request_id)[0])
+        start = min(
+            len(blocks),
+            max(
+                0,
+                (disposable_from_token + self.block_pool.hash_block_size - 1)
+                // self.block_pool.hash_block_size,
+            ),
+        )
+        disposable = tuple(
+            block
+            for block in blocks[start:]
+            if not block.is_null and block.block_hash is not None
+        )
+        if not disposable:
+            return
+        params = request.sampling_params
+        extra_args = None if params is None else params.extra_args
+        branch_handle = str(
+            (extra_args or {}).get("cis_branch_handle", request.request_id)
+        )
+        self._cis_branch_records[branch_handle] = _CISBranchRecord(
+            blocks=disposable,
+            block_hashes=tuple(block.block_hash for block in disposable),
+            branch_kind=branch_kind,
+        )
+        self._cis_branch_records.move_to_end(branch_handle)
+        while len(self._cis_branch_records) > self._cis_max_branch_records:
+            self._cis_branch_records.popitem(last=False)
+        logger.info(
+            "CIS_KV_BRANCH record request=%s kind=%s blocks=%d",
+            branch_handle,
+            branch_kind,
+            len(disposable),
+        )
+
+    def cis_resample_gc(
+        self,
+        selected_candidate_id: str | None,
+        candidate_ids: list[str],
+        rollout_ids: list[str],
+    ) -> dict[str, int]:
+        """Evict dead CIS branches after reduce while preserving the winner."""
+        protected_ids: set[int] = set()
+        selected = (
+            None
+            if selected_candidate_id is None
+            else self._cis_branch_records.get(selected_candidate_id)
+        )
+        if selected is not None:
+            protected_ids.update(
+                block.block_id
+                for block, recorded_hash in zip(
+                    selected.blocks, selected.block_hashes, strict=True
+                )
+                if block.block_hash == recorded_hash
+            )
+
+        dead_ids = [
+            request_id
+            for request_id in candidate_ids
+            if request_id != selected_candidate_id
+        ]
+        dead_ids.extend(rollout_ids)
+        evictable: list[KVCacheBlock] = []
+        stale_blocks = active_blocks = protected_blocks = 0
+        recorded_requests = 0
+        for request_id in dead_ids:
+            record = self._cis_branch_records.pop(request_id, None)
+            if record is None:
+                continue
+            recorded_requests += 1
+            for block, recorded_hash in zip(
+                record.blocks, record.block_hashes, strict=True
+            ):
+                if block.block_id in protected_ids:
+                    protected_blocks += 1
+                elif block.block_hash != recorded_hash:
+                    stale_blocks += 1
+                elif block.ref_cnt > 0:
+                    active_blocks += 1
+                else:
+                    evictable.append(block)
+
+        if selected_candidate_id is not None:
+            self._cis_branch_records.pop(selected_candidate_id, None)
+        unique_evictable = {block.block_id: block for block in evictable}
+        self.block_pool.evict_blocks(set(unique_evictable))
+        movable = [
+            block
+            for block in unique_evictable.values()
+            if block.ref_cnt == 0
+            and block.prev_free_block is not None
+            and block.next_free_block is not None
+        ]
+        if movable:
+            for block in movable:
+                self.block_pool.free_block_queue.remove(block)
+            self.block_pool.free_block_queue.prepend_n(movable)
+        result = {
+            "recorded_requests": recorded_requests,
+            "evicted_blocks": len(unique_evictable),
+            "stale_blocks": stale_blocks,
+            "active_blocks": active_blocks,
+            "protected_blocks": protected_blocks,
+        }
+        logger.info(
+            "CIS_KV_RESAMPLE_GC selected=%s candidates=%d rollouts=%d "
+            "recorded=%d evicted=%d stale=%d active=%d protected=%d",
+            selected_candidate_id,
+            len(candidate_ids),
+            len(rollout_ids),
+            recorded_requests,
+            len(unique_evictable),
+            stale_blocks,
+            active_blocks,
+            protected_blocks,
+        )
+        return result
+
