+    def _release_cis_fork_hint(self, parent_id: str) -> _CISForkHint | None:
+        hint = self._cis_fork_hints.pop(parent_id, None)
+        if hint is not None and hint.leased_blocks:
+            for block in hint.leased_blocks:
+                remaining = self._cis_lease_ref_counts[block.block_id] - 1
+                if remaining:
+                    self._cis_lease_ref_counts[block.block_id] = remaining
+                else:
+                    del self._cis_lease_ref_counts[block.block_id]
+            self.block_pool.free_blocks(reversed(hint.leased_blocks))
+            logger.info(
+                "CIS_KV_FORK lease_release parent=%s blocks=%d scope=%s held_unique=%d",
+                parent_id,
+                len(hint.leased_blocks),
+                hint.lease_scope,
+                len(self._cis_lease_ref_counts),
+            )
+        return hint
+
+    def _expire_cis_fork_hints(self) -> None:
+        now = monotonic()
+        expired = [
+            parent_id
+            for parent_id, hint in self._cis_fork_hints.items()
+            if hint.expires_at is not None and hint.expires_at <= now
+        ]
+        for parent_id in expired:
+            self._release_cis_fork_hint(parent_id)
+            logger.info("CIS_KV_FORK lease_expire parent=%s", parent_id)
+
+    def capture_cis_fork(self, request: Request) -> None:
+        """Capture a candidate's full blocks before its request is freed."""
+        self._expire_cis_fork_hints()
+        params = request.sampling_params
+        extra_args = None if params is None else params.extra_args
+        expected = int((extra_args or {}).get("cis_fork_expected_children", 0))
+        fork_handle = (extra_args or {}).get("cis_fork_handle")
+        if expected <= 0 or not self.enable_caching or self.num_kv_cache_groups != 1:
+            return
+        if not fork_handle:
+            return
+        if (
+            request.output_token_ids
+            and request.output_token_ids[-1] in params.all_stop_token_ids
+        ):
+            logger.info("CIS_KV_FORK terminal_parent parent=%s", fork_handle)
+            return
+        computed_tokens = min(request.num_computed_tokens, request.num_tokens - 1)
+        num_blocks = computed_tokens // self.block_pool.hash_block_size
+        if num_blocks <= 0:
+            return
+        blocks = tuple(self.coordinator.get_blocks(request.request_id)[0][:num_blocks])
+        block_hashes = tuple(request.block_hashes[:num_blocks])
+        if (
+            len(blocks) != num_blocks
+            or len(block_hashes) != num_blocks
+            or any(block.is_null or block.block_hash is None for block in blocks)
+        ):
+            return
+        fork_handle = str(fork_handle)
+        lease_ms = int((extra_args or {}).get("cis_fork_lease_ms", 0))
+        lease_scope = str(
+            (extra_args or {}).get("cis_fork_lease_scope", "candidate_suffix")
+        )
+        shared_prefix_tokens = int(
+            (extra_args or {}).get("cis_fork_shared_prefix_tokens", 0)
+        )
+        first_lease_block = min(
+            num_blocks,
+            max(0, shared_prefix_tokens // self.block_pool.hash_block_size),
+        )
+        leased_blocks = blocks[first_lease_block:] if lease_ms > 0 else ()
+        max_lease_fraction = float(
+            (extra_args or {}).get("cis_fork_lease_max_fraction", 1.0)
+        )
+        max_lease_blocks = max(
+            1, int(self.block_pool.num_gpu_blocks * max_lease_fraction)
+        )
+        added_unique = sum(
+            block.block_id not in self._cis_lease_ref_counts
+            for block in leased_blocks
+        )
+        if (
+            lease_scope == "full_parent"
+            and len(self._cis_lease_ref_counts) + added_unique > max_lease_blocks
+        ):
+            candidate_prefix_tokens = int(
+                (extra_args or {}).get("cis_fork_candidate_prefix_tokens", 0)
+            )
+            suffix_start = min(
+                num_blocks,
+                max(
+                    0,
+                    candidate_prefix_tokens // self.block_pool.hash_block_size,
+                ),
+            )
+            suffix_blocks = blocks[suffix_start:]
+            suffix_added_unique = sum(
+                block.block_id not in self._cis_lease_ref_counts
+                for block in suffix_blocks
+            )
+            if (
+                len(self._cis_lease_ref_counts) + suffix_added_unique
+                <= max_lease_blocks
+            ):
+                leased_blocks = suffix_blocks
+                lease_scope = "candidate_suffix_fallback"
+            else:
+                leased_blocks = ()
+                lease_scope = "direct_fallback"
+        if leased_blocks:
+            self.block_pool.touch(leased_blocks)
+            for block in leased_blocks:
+                self._cis_lease_ref_counts[block.block_id] = (
+                    self._cis_lease_ref_counts.get(block.block_id, 0) + 1
+                )
+        self._release_cis_fork_hint(fork_handle)
+        self._cis_fork_hints[fork_handle] = _CISForkHint(
+            blocks=blocks,
+            block_hashes=block_hashes,
+            num_tokens=num_blocks * self.block_pool.hash_block_size,
+            remaining_children=expected,
+            leased_blocks=leased_blocks,
+            expires_at=(monotonic() + lease_ms / 1_000.0 if lease_ms > 0 else None),
+            lease_scope=lease_scope,
+        )
+        self._cis_fork_hints.move_to_end(fork_handle)
+        while len(self._cis_fork_hints) > self._cis_max_fork_hints:
+            oldest = next(iter(self._cis_fork_hints))
+            self._release_cis_fork_hint(oldest)
+        logger.info(
+            "CIS_KV_FORK capture parent=%s blocks=%d children=%d leased=%d "
+            "scope=%s held_unique=%d budget=%d",
+            fork_handle,
+            num_blocks,
+            expected,
+            len(leased_blocks),
+            lease_scope,
+            len(self._cis_lease_ref_counts),
+            max_lease_blocks,
+        )
