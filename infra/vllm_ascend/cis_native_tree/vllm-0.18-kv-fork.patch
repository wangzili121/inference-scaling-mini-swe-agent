+    def prepend_n(self, blocks: list[KVCacheBlock]) -> None:
+        """Put free blocks at the front in their eviction order."""
+        if not blocks:
+            return
+        first_free = self.fake_free_list_head.next_free_block
+        if first_free is None:
+            raise RuntimeError(
+                "next_free_block of fake_free_list_head should always exist"
+            )
+        previous = self.fake_free_list_head
+        for block in blocks:
+            block.prev_free_block = previous
+            previous.next_free_block = block
+            previous = block
+        previous.next_free_block = first_free
+        first_free.prev_free_block = previous
+        self.num_free_blocks += len(blocks)
+
