+                num_key_value_heads=self.num_kv_heads,
+                num_heads=self.num_heads,
+                scale=self.scale,
+                pre_tokens=SWA_INT_MAX,
+                next_tokens=SWA_INT_MAX,
+                sparse_mode=0,
+            )
+            unpacked_output = packed_output.view(
+                -1, self.num_heads, self.head_size
+            )
+            if bucket.contiguous_query_start is None:
+                output.index_copy_(0, bucket.query_indices, unpacked_output)
+            else:
+                output.narrow(
+                    0,
+                    bucket.contiguous_query_start,
+                    bucket.query_indices.numel(),
