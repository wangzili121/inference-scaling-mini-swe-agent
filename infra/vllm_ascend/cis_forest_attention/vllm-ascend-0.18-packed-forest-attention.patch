+                    block_table=bucket.block_tables,
+                    input_layout="BSH",
+                    block_size=block_size,
+                    actual_seq_lengths_kv=bucket.kv_sequence_lengths,
+                    num_key_value_heads=self.num_kv_heads,
+                    num_heads=self.num_heads,
+                    scale=self.scale,
+                    pre_tokens=SWA_INT_MAX,
+                    next_tokens=SWA_INT_MAX,
+                    sparse_mode=0,
+                )
+                return packed_output.view(
+                    -1, self.num_heads, self.head_size
+                )
+        if normal_indices is not None and normal_indices.numel():
+            normal_start = attn_metadata.cis_forest_normal_query_start
