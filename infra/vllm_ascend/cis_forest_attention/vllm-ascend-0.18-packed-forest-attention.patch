+                normal_block_tables = attn_metadata.block_tables.index_select(
+                    0, normal_indices
+                )
+            else:
+                normal_count = normal_indices.numel()
+                normal_query = query.narrow(0, normal_start, normal_count)
+                normal_block_tables = attn_metadata.block_tables.narrow(
+                    0, normal_start, normal_count
+                )
+            normal_seq_lens = (
+                attn_metadata.cis_forest_normal_seq_lens_tensor
+            )
+            assert normal_seq_lens is not None
