+                else None
+            )
+            row_tokens = bucket.kv_sequence_lengths[0]
+            positions_cache = getattr(
+                self,
+                "_cis_forest_positions_cache",
+                None,
+            )
+            if positions_cache is None:
+                positions_cache = {}
+                self._cis_forest_positions_cache = positions_cache
+            positions = positions_cache.get(row_tokens)
+            if positions is None:
+                positions = torch.arange(
+                    row_tokens,
+                    dtype=torch.int32,
+                    device=self.device,
+                )
+                positions_cache[row_tokens] = positions
+            shared_lengths = torch.tensor(
+                bucket.shared_prefix_tokens,
+                dtype=torch.int32,
+                device=self.device,
+            ).view(-1, 1, 1)
+            tail_lengths = torch.tensor(
+                bucket.tail_tokens,
+                dtype=torch.int32,
+                device=self.device,
+            ).unsqueeze(-1)
+            tail_starts = (
+                bucket.max_shared_blocks
+                + torch.arange(
+                    bucket.sibling_count,
+                    dtype=torch.int32,
+                    device=self.device,
+                )
+                * bucket.max_tail_blocks
+            ).view(1, -1, 1) * block_table.block_size
+            positions_3d = positions.view(1, 1, -1)
+            attention_masks = ~(
+                (positions_3d < shared_lengths)
+                | (
+                    (positions_3d >= tail_starts)
+                    & (positions_3d < tail_starts + tail_lengths)
+                )
+            )
+            runtime_buckets.append(
+                CISPackedForestAttentionBucket(
+                    sibling_count=bucket.sibling_count,
+                    query_indices=torch.tensor(
+                        query_indices_tuple,
+                        dtype=torch.long,
+                        device=self.device,
+                    ),
+                    contiguous_query_start=contiguous_query_start,
+                    block_tables=torch.tensor(
+                        bucket.block_tables,
+                        dtype=torch.int32,
+                        device=self.device,
+                    ),
+                    attention_masks=attention_masks,
+                    kv_sequence_lengths=list(bucket.kv_sequence_lengths),
+                )
+            )
+        buckets = tuple(runtime_buckets)
+        normal_indices = torch.tensor(
+            plan.normal_request_indices,
+            dtype=torch.long,
+            device=self.device,
+        )
+        normal_seq_lens = [
+            int(self.seq_lens.np[index])
+            for index in plan.normal_request_indices
+        ]
+        normal_indices_tuple = tuple(plan.normal_request_indices)
+        normal_first = min(normal_indices_tuple, default=0)
+        normal_query_start = (
