+    def _build_cis_packed_forest_plan(
+        self,
+        num_scheduled_tokens: np.ndarray,
+    ):
+        if (
+            self.attn_state != AscendAttentionState.DecodeOnly
+            or self.pcp_size != 1
+            or self.dcp_size != 1
+            or len(self.kv_cache_config.kv_cache_groups) != 1
+            or self.speculative_config is not None
+        ):
+            return None
+        from inference_scaling.arllm.backends.packed_forest_attention import (
+            ForestBranchLayout,
+            build_packed_forest_plan,
+        )
+
+        block_table = self.input_batch.block_table[0]
+        block_table_np = block_table.get_numpy_array()
+        branches = []
+        query_start = 0
+        for request_index, request_id in enumerate(self.input_batch.req_ids):
+            request = self.requests[request_id]
+            params = request.sampling_params
+            extra_args = None if params is None else params.extra_args
+            query_length = int(num_scheduled_tokens[request_index])
+            sequence_length = int(self.seq_lens.np[request_index])
+            used_blocks = math.ceil(sequence_length / block_table.block_size)
+            branches.append(
+                ForestBranchLayout(
+                    request_index=request_index,
+                    query_start=query_start,
+                    query_length=query_length,
+                    sequence_length=sequence_length,
+                    block_ids=tuple(
+                        int(value)
+                        for value in block_table_np[request_index, :used_blocks]
+                    ),
+                    group_id=(extra_args or {}).get("cis_forest_group_id"),
+                    branch_index=(extra_args or {}).get(
+                        "cis_forest_branch_index"
+                    ),
+                    group_size=(extra_args or {}).get("cis_forest_group_size"),
+                )
+            )
+            query_start += query_length
+        plan = build_packed_forest_plan(
+            branches,
+            materialize_attention_masks=False,
+        )
+        if not plan.enabled:
+            return None
+
+        runtime_buckets = []
+        for bucket in plan.buckets:
+            query_indices_tuple = tuple(bucket.query_indices)
+            first_query = min(query_indices_tuple)
