+    def _should_hold_waiting_for_cis_forest(
+        self,
+        scheduled_running_reqs: list[Request],
+        num_scheduled_tokens: dict[str, int],
+    ) -> bool:
+        """Open bounded pure-decode windows for dense CIS sibling work."""
+
+        if (
+            self._cis_forest_window_max_steps == 0
+            or not scheduled_running_reqs
+            or not (self.waiting or self.skipped_waiting)
+        ):
+            self._cis_forest_window_streak = 0
+            return False
+        from inference_scaling.arllm.backends.packed_forest_attention import (
+            ForestWindowBranch,
+            estimate_forest_decode_window,
+        )
+
+        branches = []
+        for request in scheduled_running_reqs:
+            params = request.sampling_params
+            extra_args = None if params is None else params.extra_args
+            branches.append(
+                ForestWindowBranch(
+                    group_id=(extra_args or {}).get("cis_forest_group_id"),
+                    branch_index=(extra_args or {}).get(
+                        "cis_forest_branch_index"
+                    ),
+                    group_size=(extra_args or {}).get("cis_forest_group_size"),
+                    query_length=int(
+                        num_scheduled_tokens.get(request.request_id, 0)
+                    ),
+                    shared_prefix_tokens=int(request.num_prompt_tokens),
+                )
+            )
+        estimate = estimate_forest_decode_window(
+            branches,
+            block_size=self.block_size,
+            minimum_saved_kv_token_reads=(
+                self._cis_forest_window_min_saved_reads
+            ),
+            minimum_packed_query_fraction=(
+                self._cis_forest_window_min_packed_fraction
+            ),
+        )
+        if not estimate.enabled:
+            self._cis_forest_window_streak = 0
+            return False
+        if self._cis_forest_window_streak >= self._cis_forest_window_max_steps:
+            self._cis_forest_window_streak = 0
+            return False
+        self._cis_forest_window_streak += 1
+        self._cis_forest_window_activations += 1
+        activated = self._cis_forest_window_activations
+        if activated == 1 or activated % 100 == 0:
+            logger.info(
+                "CIS_FOREST_WINDOW activations=%d streak=%d groups=%d "
+                "packed_queries=%d total_queries=%d saved_reads=%d",
+                activated,
+                self._cis_forest_window_streak,
+                estimate.complete_groups,
+                estimate.packed_queries,
+                estimate.total_queries,
+                estimate.estimated_saved_kv_token_reads,
+            )
+        return True
